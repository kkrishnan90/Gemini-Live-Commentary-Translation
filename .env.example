# Copy to .env (gitignored). Loaded with load_dotenv(override=True), so these win over shell exports.
# gemini-3.8-live is regional: GOOGLE_CLOUD_LOCATION must be a region such as us-central1, not "global".
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
# Optional: a service-account key file (gitignored). Leave unset to use `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
# Optional: GCS bucket used as a shared source-audio cache (see tools/seed_cache.py)
# CACHE_BUCKET=your-cache-bucket
